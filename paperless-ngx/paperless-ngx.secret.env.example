# Credentials only. Copy to /srv/satellite/secrets/paperless-ngx.secret.env and chmod 600.
# Do not commit real values. Non-secret config lives in paperless-ngx.env (this repo).

PAPERLESS_SECRET_KEY=replace-with-long-random-secret

# Postgres credentials
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless_app
PAPERLESS_DBPASS=replace-me

# First-boot Paperless admin credentials
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=replace-me
PAPERLESS_ADMIN_MAIL=admin@example.com

# Dedicated token for post-consume enrich_document.py (not personal admin).
PAPERLESS_XMP_UPDATE_TOKEN=replace-me
