# Non-secret Paperless-ngx config (safe to commit).
# Credentials live only in /srv/satellite/secrets/paperless-ngx.secret.env

# Public URL via Cloudflare Tunnel; LAN still works on :3040
PAPERLESS_URL=https://paperless-ngx.didac-crst.com
PAPERLESS_ALLOWED_HOSTS=paperless-ngx.didac-crst.com,10.10.0.12,localhost
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless-ngx.didac-crst.com,http://10.10.0.12:3040
PAPERLESS_USE_X_FORWARD_HOST=true
PAPERLESS_USE_X_FORWARD_PORT=true

PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=eng+deu+spa+fra

# One global archive layout; do not use Paperless Storage Paths.
# AtlasDocs owns semantic organization. Extension is added by Paperless.
PAPERLESS_FILENAME_FORMAT={{ created_year }}/{{ title }}.{{ doc_pk }}

# Post-consume: XMP created-date enrichment only (no AtlasDocs semantics).
PAPERLESS_POST_CONSUME_SCRIPT=/usr/src/paperless/scripts/enrich_document.py
PAPERLESS_ENRICH_API_URL=http://localhost:8000

# Raspberry Pi pilot tuning
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=1
