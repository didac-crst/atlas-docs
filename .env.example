# AtlasDocs local configuration example (do not commit real secrets).

ATLASDOCS_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=atlasdocs
DATABASE_USER=atlasdocs
DATABASE_PASSWORD=atlasdocs

# Server-side Paperless REST origin (never sent to the browser).
PAPERLESS_BASE_URL=http://localhost:8000
# Browser "Open in Paperless" origin only. Leave unset to disable links.
# PAPERLESS_PUBLIC_URL=http://localhost:8000

SESSION_SECRET=dev-only-change-me
SESSION_SECURE=false
# Required for durable session + ingestion job token ciphertext (ADR 0002).
TOKEN_ENCRYPTION_KEY=dev-only-token-encryption-key

# Optional ingest / login tuning
# INGEST_MAX_UPLOAD_BYTES=52428800
# INGEST_MAX_ATTEMPTS=3
# INGEST_PROCESSING_TIMEOUT_SECONDS=1800
# INGEST_RESOLUTION_TIMEOUT_SECONDS=900
# INGEST_RESOLUTION_MAX_ATTEMPTS=30
# INGEST_BULK_MAX_DOCUMENTS=50
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
